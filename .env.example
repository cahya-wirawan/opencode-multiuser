# Single public hostname. Traefik forwards this host to the control-plane/gateway.
BASE_DOMAIN=code.example.com
CONTROL_PLANE_BIND=0.0.0.0
CONTROL_PLANE_PORT=8010
CONTROL_PLANE_URL=http://code.example.com:8443
TRAEFIK_ENTRYPOINT=websecure

# Database
DATABASE_URL=postgresql+psycopg://opencode:CHANGE_ME@127.0.0.1:5432/opencode

# Portal sessions
JWT_SECRET=CHANGE_ME
JWT_TTL_MINUTES=480
SESSION_COOKIE_NAME=oc_session
WORKSPACE_COOKIE_NAME=oc_workspace
COOKIE_SECURE=false

# Authentication
# Local authentication works out of the box. Set LOCAL_AUTH_ENABLED=false after
# OIDC is verified if you want SSO-only access.
LOCAL_AUTH_ENABLED=true
ALLOW_REGISTRATION=true

# Generic OpenID Connect (disabled until configured).
OIDC_ENABLED=false
OIDC_ISSUER=
# Optional override. Default: <OIDC_ISSUER>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_DISPLAY_NAME=Corporate SSO
# Optional override. Default: <CONTROL_PLANE_URL>/auth/oidc/callback
OIDC_REDIRECT_URI=
OIDC_USE_PKCE=true
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_ROLE=developer
OIDC_USERNAME_CLAIM=preferred_username
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_STATE_COOKIE_NAME=oc_oidc_state
OIDC_STATE_TTL_SECONDS=600

# Podman/runtime
PODMAN_BIN=/usr/bin/podman
WORKSPACE_IMAGE=localhost/opencode-workspace:latest
OPENCODE_VERSION=1.18.30
OPENCODE_REGISTRY_URL=https://registry.npmjs.org/opencode-ai/latest
OPENCODE_UPDATE_TIMEOUT_SECONDS=900
PODMAN_NETWORK=opencode-net
DATA_ROOT=%h/.local/share/opencode-multiuser
MAX_SLOTS=10
WORKSPACE_MEMORY=8g
WORKSPACE_CPUS=4
WORKSPACE_PIDS_LIMIT=1024
WORKSPACE_READY_TIMEOUT_SECONDS=45
WORKSPACE_READY_POLL_INTERVAL_SECONDS=0.5
WORKSPACE_IDLE_TIMEOUT_MINUTES=30
WORKSPACE_REAPER_INTERVAL_SECONDS=60
STOP_WORKSPACES_ON_LOGOUT=true
WORKSPACE_HOST_PORT_BASE=41000

# Traefik
TRAEFIK_DYNAMIC_DIR=%h/.local/share/opencode-multiuser/traefik-dynamic
TRAEFIK_TLS=false
TRAEFIK_CERT_RESOLVER=letsencrypt
OPENCODE_CORS=
