[Unit]
Description=OpenCode Multiuser Control Plane
After=network-online.target postgres.service traefik.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/opt/opencode-multiuser
EnvironmentFile=%h/.config/opencode-multiuser/control-plane.env
ExecStart=%h/opt/opencode-multiuser/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/opencode-multiuser

[Install]
WantedBy=default.target
