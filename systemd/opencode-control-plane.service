[Unit]
Description=OpenCode Multiuser Control Plane and Gateway
After=network-online.target postgres.service traefik.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/opt/opencode-multiuser
EnvironmentFile=%h/.config/opencode-multiuser/control-plane.env
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=%h/opt/opencode-multiuser/.venv/bin/uvicorn app.main:app --host ${CONTROL_PLANE_BIND} --port ${CONTROL_PLANE_PORT}
Restart=on-failure
RestartSec=3
Delegate=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/opencode-multiuser
ReadWritePaths=%h/.local/share/containers
ReadWritePaths=%t

[Install]
WantedBy=default.target
